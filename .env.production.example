# ═══════════════════════════════════════════════════════════════
# YAHRIA CODE OS — .env.production (modèle, R15)
#   cp .env.production.example .env.production
#   — remplir OBLIGATOIREMENT les 3 champs marqués REQUIS.
#   Ne JAMAIS committer .env.production (déjà couvert par .gitignore).
# ═══════════════════════════════════════════════════════════════

# ── REQUIS ─────────────────────────────────────────────────────────
# Génération : openssl rand -base64 24
POSTGRES_PASSWORD=
# Domaine public pointant vers le VPS (A/AAAA DNS) — ex: yahria.example.com
YAHRIA_DOMAIN=

# ── PostgreSQL (dérivés, ajuster si besoin) ────────────────────────
POSTGRES_USER=yahria
POSTGRES_DB=yahria

# ── Sandbox conteneur durci (INV-215) ──────────────────────────────
# docker build -f docker/sandbox.Dockerfile -t yahria-sandbox:latest .
YAHRIA_SANDBOX_BACKEND=docker
YAHRIA_SANDBOX_IMAGE=yahria-sandbox:latest

# ── Alerting externe (D.22 / KRN-039 / INV-236) ────────────────────
# Récepteur POST JSON ; signature X-Yahria-Signature: sha256=HMAC(secret, body)
YAHRIA_ALERT_WEBHOOK_URL=
YAHRIA_ALERT_WEBHOOK_SECRET=

# ── Fabric LLM (INV-213 : serveur uniquement) — remplir au moins un
ZAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
